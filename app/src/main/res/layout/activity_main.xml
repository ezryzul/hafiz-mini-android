<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9FC">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_hafiz"
            android:contentDescription="Ikon Hafiz"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Hafiz"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#43233A"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Pengurus Akaun • Lovely Boutique"
            android:textSize="15sp"
            android:textColor="#765A6D"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnVoice"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:text="🎙  Bercakap dengan Hafiz"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnSale"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🧾  Rekod Jualan"
            android:textAllCaps="false"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnPurchase"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🛒  Rekod Pembelian"
            android:textAllCaps="false"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnQuotation"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="📄  Buat Sebut Harga"
            android:textAllCaps="false"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnToday"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="📊  Laporan Hari Ini"
            android:textAllCaps="false"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnAccounts"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="💼  Buka Lovely Accounts"
            android:textAllCaps="false"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="V3 membuka aplikasi ChatGPT terus. Arahan pantas akan disalin ke clipboard supaya anda boleh tampal atau terus beri arahan melalui suara tanpa melalui halaman “Try in app”."
            android:textSize="13sp"
            android:textColor="#806A79"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="28dp" />
    </LinearLayout>
</ScrollView>
